{
  "source": "mckitrick-1991",
  "$comment": "GENERATED. Which muscle record each of this source's names belongs to, keyed 'name|region'. Per source deliberately: two authors assigning one muscle to different groups is the thing this dataset exists to preserve, and a global name table would destroy it.",
  "mapping": {
    "'rhomboideus' (superficialis + profundus)|pectoral": "rhomboideus",
    "biceps brachii|arm": "biceps-brachii",
    "brachialis|arm": "brachialis",
    "extensor digitorum communis|forearm": "extensor-digitorum",
    "extensor metacarpi radialis|forearm": "extensor-antebrachii-carpi-radialis",
    "extensor metacarpi ulnaris|forearm": "extensor-antebrachii-carpi-ulnaris",
    "latissimus dorsi (pars cranialis + pars caudalis)|pectoral": "latissimus-dorsi",
    "pronator profundus|forearm": "pronator-quadratus",
    "pronator superficialis|forearm": "pronator-teres",
    "scapulohumeralis cranialis|pectoral": "scapulohumeralis-anterior",
    "scapulotriceps + humerotriceps|arm": "triceps-brachii",
    "serratus superficialis + profundus|pectoral": "serratus-anterior",
    "supinator|forearm": "supinator"
  }
}
