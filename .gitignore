# ---------------------------------------------------------------------------
# Primary literature — NEVER commit.
# The papers/ directory holds copyrighted PDFs. Only the markdown reading
# notes and extracted data are version controlled.
# ---------------------------------------------------------------------------
*.pdf
*.PDF
*.epub
*.djvu

# Supplementary material that often ships alongside papers
papers/**/*.docx
papers/**/*.html
papers/**/*.htm
papers/**/*.xlsx
papers/**/*.zip
papers/**/*.tar.gz

# Raw pdftotext dumps (regenerable from the PDFs; also copyrighted text)
papers/extracted/
data/raw/

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Node / web tooling
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
yarn-error.log*
.env
.env.local

# ---------------------------------------------------------------------------
# Python (data-munging scripts)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Claude Code local settings (machine-specific)
# ---------------------------------------------------------------------------
.claude/settings.local.json

# Generated analysis exports (rebuild with scripts/export_matrix.py)
export/

# The round-trip scratch dir. data/observations/ and data/mapping/ are the source
# of truth as of Task 5 and are tracked; data/muscles-*.json is generated from
# them but stays committed, because the app fetches it directly and there is no
# build step between the repo and the page.
.roundtrip/
